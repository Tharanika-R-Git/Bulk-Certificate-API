# ---- Application ----
APP_NAME=bulk-certificate-generator
APP_ENV=development
LOG_LEVEL=INFO

# Maximum number of recipients accepted in a single bulk request
MAX_BATCH_SIZE=1000

# ---- Database ----
# SQLAlchemy 2.x URL. Uses psycopg (v3) driver.
DATABASE_URL=postgresql+psycopg://certs:certs@localhost:5432/certs

# ---- Redis / Celery ----
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---- Storage ----
# Base directory for locally stored certificate PDFs.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=storage

# ---- Reliability tuning ----
# Seconds after which a recipient stuck in PROCESSING is considered abandoned
# (e.g. the worker crashed) and may be reclaimed / reaped.
RECIPIENT_LOCK_TIMEOUT_SECONDS=300
# Maximum automatic retries for transient failures.
MAX_RETRIES=3
# Base backoff (seconds) for exponential retry: delay = BACKOFF_BASE * 2**attempt
RETRY_BACKOFF_BASE_SECONDS=5
